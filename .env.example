# ---------------------------------------------------------------------------
# SSL Billing — environment variables
# Copy to .env for local development. NEVER commit real keys (.env is gitignored).
# On Cloudflare, set these with:  wrangler secret put <NAME>
# ---------------------------------------------------------------------------

# Supabase (server-side only). The service-role key bypasses RLS and must never
# reach the browser — it is only ever read by the Express server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Session signing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# Seed admin (created on first boot if the account does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Your Name"

# Set to "true" to also seed demo customers/invoices. Leave unset in production.
SEED_SAMPLE_DATA=

# Optional: live GSTIN verification (https://gstverify.co.in/dev-api.php)
GSTVERIFY_API_KEY=
